{
  "name": "@dev-inspector/extension",
  "displayName": "Inspector Lab",
  "version": "0.1.0",
  "description": "A movable, in-page web inspector for learning and lightweight DOM debugging.",
  "author": "Luan Gjokaj",
  "private": true,
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "cherry-styled-components": "^0.2.11",
    "plasmo": "^0.90.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "styled-components": "^6.4.4"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.2",
    "@types/node": "^26",
    "@types/react": "^19.2",
    "@types/react-dom": "^19.2",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  },
  "manifest": {
    "permissions": [
      "activeTab",
      "cookies",
      "scripting",
      "storage",
      "webRequest"
    ],
    "optional_host_permissions": [
      "http://*/*",
      "https://*/*"
    ]
  }
}
